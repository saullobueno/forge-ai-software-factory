# Exemplo de variáveis para staging/produção.
# Copie os valores para o painel do provedor correspondente; não commite .env real.

# API (ex.: Render)
NODE_ENV=production
API_PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
JWT_SECRET=change-me-to-a-long-random-secret

# Web (ex.: Vercel)
# Importante: o Next.js grava rewrites() no build. Defina API_INTERNAL_URL
# antes de rodar o build/deploy do app web.
API_INTERNAL_URL=https://forge-api.example.com

# IA real ainda não está conectada ao orquestrador; deixe chaves externas
# desativadas até a frente de providers reais ser implementada.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
