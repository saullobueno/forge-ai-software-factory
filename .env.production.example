# Exemplo de variáveis para staging/produção.
# Copie os valores para o painel do provedor correspondente; não commite .env real.

# API (ex.: Render)
NODE_ENV=production
API_PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
JWT_SECRET=change-me-to-a-long-random-secret

# Web (ex.: Vercel)
# Importante: o Next.js grava rewrites() no build. Defina API_INTERNAL_URL
# antes de rodar o build/deploy do app web.
API_INTERNAL_URL=https://forge-api.example.com

# IA real dos agentes. Deixe AI_PROVIDER=mock para demo determinística, ou
# selecione gemini/groq e configure chave + modelo no serviço da API.
AI_PROVIDER=mock
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_REQUEST_TIMEOUT_MS=30000
# Anthropic ainda não tem adapter implementado.
# ANTHROPIC_API_KEY=
