# Exemplo de variáveis para staging/produção.
# Copie os valores para o painel do provedor correspondente; não commite .env real.

# API (ex.: Render)
NODE_ENV=production
# 10000, não 3001: o Render só varre um conjunto fixo de portas conhecidas
# para autodetectar onde o serviço escuta (ver docs/production-deployment.md).
API_PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379
JWT_SECRET=change-me-to-a-long-random-secret

# Web (ex.: Vercel)
# Lido em runtime pelo Route Handler do proxy same-origem (não em build
# time) — ver docs/production-deployment.md.
API_INTERNAL_URL=https://forge-api.example.com

# IA real dos agentes. Deixe AI_PROVIDER=mock para demo determinística, ou
# selecione gemini/groq e configure chave + modelo no serviço da API.
AI_PROVIDER=mock
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# AI_REQUEST_TIMEOUT_MS=30000
# Limites diários (últimas 24h) — RECOMENDADOS para a demo pública com IA real
# (Groq etc.), onde as contas de demonstração são compartilhadas por todos os
# visitantes. Sem eles, não há teto de gasto. Ver docs/production-deployment.md.
# AI_ORG_DAILY_TOKEN_LIMIT=300000
# AI_ORG_DAILY_COST_LIMIT_USD=1
# AI_USER_DAILY_TOKEN_LIMIT=100000
# AI_USER_DAILY_COST_LIMIT_USD=0.30
# Projetos (por slug, separados por vírgula) que não podem ser editados nem
# excluídos, nem as tarefas deles. Default: forge-web-app (projeto do seed).
# PROTECTED_PROJECT_SLUGS=forge-web-app
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Sessões e 2FA (opcional; veja docs/production-deployment.md)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_AGE_DAYS=30
# TOTP_ENCRYPTION_KEY=troque-por-um-segredo-longo-e-aleatorio
# PROTECTED_USER_EMAIL_SUFFIXES=@acme-platform.example
