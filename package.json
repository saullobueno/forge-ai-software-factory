{
  "name": "forge-ai-software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Forge — fábrica de software nativa em IA",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --cache",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @forge/database db:generate",
    "db:migrate": "pnpm --filter @forge/database db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  }
}
