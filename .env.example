# Copie para .env e ajuste conforme necessário.
# Sem DATABASE_URL/REDIS_URL definidos, o Forge roda inteiramente local:
# - Banco: PGlite (Postgres real embarcado em WASM, sem Docker)
# - Fila: implementação em memória (mesma interface do BullMQ)
# - IA: provedor mock determinístico (sem chamadas externas)

# Postgres real (ex.: `docker compose up -d postgres`)
# DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# Redis real (ex.: `docker compose up -d redis`)
# REDIS_URL=redis://localhost:6379

# Caminho do arquivo local do PGlite quando DATABASE_URL não está definido
# DATABASE_LOCAL_PATH=./.data/forge-dev.pglite

# Chave de provedor de IA real (Anthropic). Sem isso, usa o adaptador mock.
# ANTHROPIC_API_KEY=

# Segredo de assinatura dos JWTs de sessão (Fase 2 — Auth/RBAC). Sem isso,
# usa um default óbvio e INSEGURO só para não bloquear `pnpm dev` local —
# defina um valor real antes de qualquer deploy.
# JWT_SECRET=

NODE_ENV=development
API_PORT=3001
WEB_PORT=3000

# URL interna que o servidor Next.js (apps/web) usa para repassar `/api/*`
# para a API real via rewrites() (Fase 4 — proxy same-origin, necessário
# para o cookie httpOnly `forge_session` funcionar no browser). Só
# importa quando API_PORT muda do default 3001; senão o default já bate.
# API_INTERNAL_URL=http://127.0.0.1:3001
